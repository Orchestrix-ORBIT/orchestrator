{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": [
        "arn:aws:ecr:ap-south-1:349476472955:repository/orchestrix-core-api",
        "arn:aws:ecr:ap-south-1:349476472955:repository/orchestrix-realtime",
        "arn:aws:ecr:ap-south-1:349476472955:repository/orchestrix-context-engine",
        "arn:aws:ecr:ap-south-1:349476472955:repository/orchestrix-frontend"
      ]
    }
  ]
}

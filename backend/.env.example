# PostgreSQL Container Configuration
POSTGRES_USER=orchestrix_app
POSTGRES_PASSWORD=app_secret_password
POSTGRES_DB=orchestrator_db

# Database Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orchestrator_db
DB_USERNAME=orchestrix_app
DB_PASSWORD=app_secret_password

# JWT Authentication Secret Key & Expiration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION_MS=86400000

# AES-256 Encryption Secret Key (Must be 32 characters / 256 bits)
ENCRYPTION_SECRET_KEY=My32ByteSuperSecretKeyForAES256!
